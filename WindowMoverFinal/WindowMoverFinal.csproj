<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WindowMover.Core\WindowMover.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The live tests drive the real move code, which is internal to this app - there is
		     no library to test it through, and making it public for the tests' sake would say
		     it is an API for someone to use. -->
		<InternalsVisibleTo Include="WindowMover.LiveTests" />
	</ItemGroup>
</Project>
